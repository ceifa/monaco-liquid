{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023", "dom"],
        "module": "nodenext",
        "rootDir": "src",
        "outDir": "dist",
        "types": [],
        "declaration": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
